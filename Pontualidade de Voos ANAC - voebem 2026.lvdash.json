{
  "datasets": [
    {
      "name": "kpis_voos",
      "displayName": "KPIs de voos",
      "config": {
        "version": "1.1",
        "source": "voebem.gold.obt_voos",
        "comment": "KPIs gerais do periodo, uma linha por etapa de voo. Criterio de pontualidade 15 minutos.",
        "measures": [
          {
            "name": "voos",
            "expr": "COUNT(*)",
            "displayName": "Voos no periodo"
          },
          {
            "name": "pct_partida_pontual",
            "expr": "100.0 * try_divide(SUM(CASE WHEN partida_pontual THEN 1 ELSE 0 END), SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END))",
            "displayName": "Partida pontual (%)"
          },
          {
            "name": "pct_cancelados",
            "expr": "100.0 * SUM(CASE WHEN voo_cancelado THEN 1 ELSE 0 END) / COUNT(*)",
            "displayName": "Cancelados (%)"
          },
          {
            "name": "atraso_medio_partida_min",
            "expr": "AVG(atraso_partida_min)",
            "displayName": "Atraso medio de partida (min)"
          }
        ]
      }
    },
    {
      "name": "aeroportos_atraso",
      "displayName": "Aeroportos com mais atraso (5.000+ voos)",
      "config": {
        "source": "SELECT\n  nome_aeroporto_origem,\n  municipio_origem,\n  uf_origem,\n  COUNT(*) AS voos,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_medio_min,\n  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END),\n                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_atrasados\nFROM voebem.gold.obt_voos WHERE pais_origem = 'Brasil' GROUP BY 1, 2, 3 HAVING COUNT(*) >= 5000 ORDER BY pct_atrasados DESC LIMIT 10",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "atraso_medio_min",
            "expr": "AVG(atraso_medio_min)",
            "displayName": "Atraso medio (min)"
          },
          {
            "name": "pct_atrasados",
            "expr": "AVG(pct_atrasados)",
            "displayName": "Atraso na partida (%)"
          }
        ],
        "version": "1.1",
        "comment": "P1 - aeroportos brasileiros de origem com maior percentual de atraso na partida, corte de 5.000 voos.",
        "dimensions": [
          {
            "name": "nome_aeroporto_origem",
            "expr": "nome_aeroporto_origem",
            "displayName": "Aeroporto de origem"
          },
          {
            "name": "municipio_origem",
            "expr": "municipio_origem",
            "displayName": "Municipio"
          },
          {
            "name": "uf_origem",
            "expr": "uf_origem",
            "displayName": "UF"
          }
        ]
      }
    },
    {
      "name": "rotas_sem_recuperacao",
      "displayName": "Rotas sem recuperação de atraso (2.000+ voos)",
      "config": {
        "source": "SELECT\n  rota_municipios,\n  rota_icao,\n  COUNT(*) AS voos,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_saida_min,\n  ROUND(AVG(atraso_chegada_min), 2) AS atraso_chegada_min,\n  ROUND(AVG(minutos_recuperados), 2) AS recuperados_medio_min\nFROM voebem.gold.obt_voos WHERE minutos_recuperados IS NOT NULL GROUP BY 1, 2 HAVING COUNT(*) >= 2000 ORDER BY recuperados_medio_min ASC LIMIT 10",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "atraso_saida_min",
            "expr": "AVG(atraso_saida_min)",
            "displayName": "Atraso de saida (min)"
          },
          {
            "name": "atraso_chegada_min",
            "expr": "AVG(atraso_chegada_min)",
            "displayName": "Atraso de chegada (min)"
          },
          {
            "name": "recuperados_medio_min",
            "expr": "AVG(recuperados_medio_min)",
            "displayName": "Minutos recuperados em voo"
          }
        ],
        "version": "1.1",
        "comment": "P5b - rotas em que a recuperacao de atraso nao acontece (perde tempo no ar), corte de 2.000 voos.",
        "dimensions": [
          {
            "name": "rota_municipios",
            "expr": "rota_municipios",
            "displayName": "Rota"
          },
          {
            "name": "rota_icao",
            "expr": "rota_icao",
            "displayName": "Rota (ICAO)"
          }
        ]
      }
    },
    {
      "name": "companhias_pontualidade",
      "displayName": "Pontualidade por companhia (10.000+ voos)",
      "config": {
        "source": "SELECT\n  nome_companhia,\n  COUNT(*) AS voos,\n  ROUND(100.0 * SUM(CASE WHEN voo_cancelado THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_cancelados,\n  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual THEN 1 ELSE 0 END),\n                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_pontuais,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_medio_min\nFROM voebem.gold.obt_voos GROUP BY 1 HAVING COUNT(*) >= 10000 ORDER BY pct_pontuais DESC",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "pct_pontuais",
            "expr": "AVG(pct_pontuais)",
            "displayName": "Partidas pontuais (%)"
          },
          {
            "name": "pct_cancelados",
            "expr": "AVG(pct_cancelados)",
            "displayName": "Cancelados (%)"
          },
          {
            "name": "atraso_medio_min",
            "expr": "AVG(atraso_medio_min)",
            "displayName": "Atraso medio (min)"
          }
        ],
        "version": "1.1",
        "comment": "P3 - pontualidade x cancelamento por companhia, controle de porte com corte de 10.000 voos.",
        "dimensions": [
          {
            "name": "nome_companhia",
            "expr": "nome_companhia",
            "displayName": "Companhia"
          }
        ]
      }
    },
    {
      "name": "rotas_atraso",
      "displayName": "Piores rotas domésticas (2.000+ voos)",
      "config": {
        "source": "SELECT\n  rota_municipios,\n  rota_icao,\n  COUNT(*) AS voos,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_medio_min,\n  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END),\n                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_atrasados\nFROM voebem.gold.obt_voos WHERE escopo_voo = 'Domestico' GROUP BY 1, 2 HAVING COUNT(*) >= 2000 ORDER BY atraso_medio_min DESC LIMIT 10",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "atraso_medio_min",
            "expr": "AVG(atraso_medio_min)",
            "displayName": "Atraso medio (min)"
          },
          {
            "name": "pct_atrasados",
            "expr": "AVG(pct_atrasados)",
            "displayName": "Atraso na partida (%)"
          }
        ],
        "version": "1.1",
        "comment": "P1b - piores rotas domesticas por atraso medio de partida, corte de 2.000 voos.",
        "dimensions": [
          {
            "name": "rota_municipios",
            "expr": "rota_municipios",
            "displayName": "Rota"
          },
          {
            "name": "rota_icao",
            "expr": "rota_icao",
            "displayName": "Rota (ICAO)"
          }
        ]
      }
    },
    {
      "name": "recuperacao_companhias",
      "displayName": "Recuperação de atraso por companhia (10.000+ voos)",
      "config": {
        "source": "SELECT\n  nome_companhia,\n  COUNT(*) AS voos,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_saida_min,\n  ROUND(AVG(atraso_chegada_min), 2) AS atraso_chegada_min,\n  ROUND(AVG(minutos_recuperados), 2) AS recuperados_medio_min\nFROM voebem.gold.obt_voos WHERE minutos_recuperados IS NOT NULL GROUP BY 1 HAVING COUNT(*) >= 10000 ORDER BY recuperados_medio_min DESC",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "atraso_saida_min",
            "expr": "AVG(atraso_saida_min)",
            "displayName": "Atraso de saida (min)"
          },
          {
            "name": "atraso_chegada_min",
            "expr": "AVG(atraso_chegada_min)",
            "displayName": "Atraso de chegada (min)"
          },
          {
            "name": "recuperados_medio_min",
            "expr": "AVG(recuperados_medio_min)",
            "displayName": "Minutos recuperados em voo"
          }
        ],
        "version": "1.1",
        "comment": "P5 - quanto atraso de saida cada companhia recupera em voo, corte de 10.000 voos com metrica.",
        "dimensions": [
          {
            "name": "nome_companhia",
            "expr": "nome_companhia",
            "displayName": "Companhia"
          }
        ]
      }
    },
    {
      "name": "atraso_por_hora",
      "displayName": "Atraso por hora do dia",
      "config": {
        "source": "SELECT\n  hora_partida_prevista AS hora,\n  COUNT(*) AS voos,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_medio_min,\n  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END),\n                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_atrasados\nFROM voebem.gold.obt_voos WHERE hora_partida_prevista IS NOT NULL GROUP BY 1 ORDER BY 1",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "atraso_medio_min",
            "expr": "AVG(atraso_medio_min)",
            "displayName": "Atraso medio (min)"
          },
          {
            "name": "pct_atrasados",
            "expr": "AVG(pct_atrasados)",
            "displayName": "Atraso na partida (%)"
          }
        ],
        "version": "1.1",
        "comment": "P2 - atraso medio de partida por hora prevista do dia, efeito cascata.",
        "dimensions": [
          {
            "name": "hora",
            "expr": "hora",
            "displayName": "Hora prevista de partida"
          }
        ]
      }
    },
    {
      "name": "escopo_comparativo",
      "displayName": "Doméstico x internacional",
      "config": {
        "source": "SELECT\n  escopo_voo,\n  COUNT(*) AS voos,\n  ROUND(AVG(atraso_partida_min), 2) AS atraso_medio_min,\n  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END),\n                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_atrasados\nFROM voebem.gold.obt_voos GROUP BY 1 ORDER BY voos DESC",
        "measures": [
          {
            "name": "voos",
            "expr": "SUM(voos)",
            "displayName": "Voos"
          },
          {
            "name": "atraso_medio_min",
            "expr": "AVG(atraso_medio_min)",
            "displayName": "Atraso medio (min)"
          },
          {
            "name": "pct_atrasados",
            "expr": "AVG(pct_atrasados)",
            "displayName": "Atraso na partida (%)"
          }
        ],
        "version": "1.1",
        "comment": "P4 - comparacao do atraso de partida entre voos domesticos e internacionais.",
        "dimensions": [
          {
            "name": "escopo_voo",
            "expr": "escopo_voo",
            "displayName": "Escopo do voo"
          }
        ]
      }
    }
  ],
